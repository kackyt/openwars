+/// 進軍路作戦へ回す占領役のうち、取れる見込みのある未取得の施設へ移動力の範囲で届くものを、
+/// その施設の占領役に加える（1施設あたり [`NEAR_CAPTURE_CAP`] 体まで）。占領の担当が施設ごとに
+/// 1体だけだと、その1体が遅れたり撃たれたりすると、すぐ隣に元気な占領役が居ても占領が
+/// 始まらない（分岐シミュレーションでは、T20に取れなかった西の都市の半分は、周り3マスに
+/// 自軍の占領役が2体余り居るのに誰も乗っていなかった）。戻り値は進軍路作戦へ回す残り。
+pub(super) fn reinforce_nearby_captures(
+    world: &World,
+    capture_responsibilities: &mut Vec<CampaignResponsibility>,
+    released: Vec<Entity>,
+    orders: &[crate::ai::v4::capital_route::force_demand::RouteOrder],
+) -> Vec<Entity> {
+    let Some(map) = world.get_resource::<Map>() else {
+        return released;
+    };
+    let mut counts = HashMap::<GridPosition, usize>::default();
+    for responsibility in capture_responsibilities.iter() {
+        *counts.entry(responsibility.target).or_default() += responsibility.members.len();
+    }
+    let mut remaining = Vec::new();
+    for entity in released {
+        let (Some(position), Some(stats), Some(faction)) = (
+            world.get::<GridPosition>(entity),
+            world.get::<UnitStats>(entity),
+            world.get::<Faction>(entity),
+        ) else {
+            remaining.push(entity);
+            continue;
+        };
+        if !stats.can_capture {
+            remaining.push(entity);
+            continue;
+        }
+        let player = faction.0;
+        let target = world
+            .iter_entities()
+            .filter_map(|candidate| {
+                let target = *candidate.get::<GridPosition>()?;
+                let property = candidate.get::<Property>()?;
+                (property.owner_id != Some(player)
+                    && map.distance(position.x, position.y, target.x, target.y)
+                        <= stats.max_movement
+                    && counts.get(&target).copied().unwrap_or(0) < NEAR_CAPTURE_CAP
+                    && capture_target_allowed(world, map, player, target, orders))
+                .then_some(target)
+            })
+            .min_by_key(|target| {
+                (
+                    map.distance(position.x, position.y, target.x, target.y),
+                    target.y,
+                    target.x,
+                )
+            });
+        match target {
+            Some(target) => {
+                *counts.entry(target).or_default() += 1;
+                capture_responsibilities.push(CampaignResponsibility {
+                    mission_type: MissionType::Capture,
+                    target,
+                    members: vec![entity],
+                });
+            }
+            None => remaining.push(entity),
+        }
+    }
+    remaining
+}
