+/// 主武器・副武器のうち有効な方の基本ダメージ。
+fn best_damage(chart: &DamageChart, attacker: UnitType, defender: UnitType) -> u32 {
+    chart.get_base_damage(attacker, defender).unwrap_or(0).max(
+        chart
+            .get_base_damage_secondary(attacker, defender)
+            .unwrap_or(0),
+    )
+}
