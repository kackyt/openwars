+    let capturer = unit(&mut world, ME, UnitType::Infantry, pos(27, 1), 100);
+    let tank = unit(&mut world, ME, UnitType::Tank, pos(3, 1), 100);
+    // 敵歩兵は(14,1)にいる。中立都市(22,1)へは距離8（到着3手番・完了5手番）、自軍都市(4,1)へは距離10（到着4手番・完了6手番）。
+    // 最短占領目標は中立都市であり、かつ中立都市から離れているため防衛脅威にも守備敵にもならない。
