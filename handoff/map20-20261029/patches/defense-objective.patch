+/// 占領力の10刻みを考慮し、次の完了手番を延ばす最小被害を求める。
+#[test]
+fn minimum_defense_damage_respects_capture_power_rounding() {
+    assert_eq!(minimum_capture_delay_damage(200, 100), 10);
+    assert_eq!(minimum_capture_delay_damage(100, 100), 10);
+    assert_eq!(minimum_capture_delay_damage(40, 100), 70);
+    assert_eq!(minimum_capture_delay_damage(1, 100), 100);
+    assert_eq!(minimum_capture_delay_damage(0, 100), 100);
+}
