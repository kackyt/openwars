+fn defense_does_not_count_one_firing_tile_twice() {
+    let objective = pos(40, 0);
+    let mut world = board(60, 1, objective);
+    let own_city = pos(6, 0);
+    let mut city = Property::new(Terrain::City, Some(ME), 200);
+    city.capture_points = 40;
+    world.spawn((own_city, city));
+    world
+        .resource_mut::<DamageChart>()
+        .insert_damage(UnitType::Tank, UnitType::Infantry, 40);
+    world.resource_mut::<DamageChart>().insert_secondary_damage(
+        UnitType::Tank,
+        UnitType::Infantry,
+        40,
+    );
+    let tanks = [pos(0, 0), pos(1, 0)].map(|at| unit(&mut world, ME, UnitType::Tank, at, 100));
+    unit(&mut world, ENEMY, UnitType::Infantry, own_city, 100);
+    let allocation = allocate_defenses(&world, &tanks, own_city);
+    assert!(
+        allocation.responsibilities.is_empty(),
+        "1つの射点を2体が同時に使う防衛計画は成立しない"
+    );
+    assert!(
+        allocation.assigned.iter().all(|assigned| !assigned),
+        "不成立の仮予約を確定しない"
+    );
+}
