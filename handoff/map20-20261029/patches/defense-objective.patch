+/// 敵ZOCで今手番の射点へ届かない部隊を、期限直前の迎撃役にしない。
+#[test]
+fn defense_does_not_assume_movement_through_enemy_zoc_in_one_turn() {
+    let objective = pos(40, 1);
+    let mut world = board(60, 3, objective);
+    let own_city = pos(6, 1);
+    let mut city = Property::new(Terrain::City, Some(ME), 200);
+    city.capture_points = 100;
+    world.spawn((own_city, city));
+    let tank = unit(&mut world, ME, UnitType::Tank, pos(0, 1), 100);
+    unit(&mut world, ENEMY, UnitType::Infantry, own_city, 100);
+    unit(&mut world, ENEMY, UnitType::Tank, pos(3, 0), 100);
+
+    let occupancy = [(own_city, UnitType::Infantry), (pos(3, 0), UnitType::Tank)]
+        .into_iter()
+        .map(|(position, unit_type)| {
+            (
+                (position.x, position.y),
+                OccupantInfo {
+                    player_id: ENEMY,
+                    is_transport: false,
+                    unit_type,
+                    loadable_types: Vec::new(),
+                    free_slots: 0,
+                },
+            )
+        })
+        .collect();
+    let map = world.resource::<Map>();
+    let stats = world.get::<UnitStats>(tank).unwrap();
+    let reachable = crate::systems::movement::calculate_reachable_tiles(
+        map,
+        &occupancy,
+        (0, 1),
+        stats.movement_type,
+        stats.max_movement,
+        99,
+        ME,
+        stats.unit_type,
+        world.resource::<MasterDataRegistry>(),
+    );
+    assert!(
+        reachable
+            .iter()
+            .all(|(x, y)| map.distance(*x, *y, own_city.x, own_city.y) > 1),
+        "fixture上は敵ZOCにより今手番の射点に届かない: {reachable:?}"
+    );
+    let responsibilities = allocate(&world, &[tank], &[], objective);
+    let for_tank = responsibility_of(&responsibilities, tank);
+    assert_ne!(
+        for_tank.target, own_city,
+        "期限に届かない迎撃を成立扱いしない"
+    );
+}
