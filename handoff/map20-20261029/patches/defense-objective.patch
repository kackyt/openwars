+/// 自拠点への占領を遅らせるのに十分な攻撃があれば、残りの戦力を本来の攻勢へ残す。
+#[test]
+fn defense_uses_only_force_needed_to_delay_capture() {
+    let objective = pos(25, 1);
+    let mut world = board(30, 3, objective);
+    let own_city = pos(6, 1);
+    world.spawn((own_city, Property::new(Terrain::City, Some(ME), 200)));
+    let tanks = [pos(3, 0), pos(3, 2)].map(|at| unit(&mut world, ME, UnitType::Tank, at, 100));
+    let enemy_at = pos(10, 1);
+    unit(&mut world, ENEMY, UnitType::Infantry, enemy_at, 100);
+
+    let responsibilities = allocate(&world, &tanks, &[], objective);
+    let interceptors = responsibilities
+        .iter()
+        .filter(|responsibility| {
+            responsibility.mission_type == MissionType::Attack && responsibility.target == enemy_at
+        })
+        .flat_map(|responsibility| responsibility.members.iter().copied())
+        .collect::<Vec<_>>();
+    assert_eq!(
+        interceptors.len(),
+        1,
+        "一撃で占領が遅れる場合は、もう一両を攻勢へ残す"
+    );
+}
