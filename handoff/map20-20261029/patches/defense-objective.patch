+/// 防衛段階だけを観測し、後段の正当な進軍・攻撃と区別する。
+fn allocate_defenses(world: &World, members: &[Entity], at: GridPosition) -> Allocation {
+    let board = Board {
+        map: world.resource::<Map>(),
+        data: world.resource::<MasterDataRegistry>(),
+        chart: world.resource::<DamageChart>(),
+        islands: world.resource::<IslandMap>(),
+    };
+    let all = world
+        .iter_entities()
+        .filter_map(|entity| unit_view(world, entity.id()))
+        .collect::<Vec<_>>();
+    let fighters = members
+        .iter()
+        .filter_map(|entity| unit_view(world, *entity))
+        .collect::<Vec<_>>();
+    let enemies = all
+        .iter()
+        .filter(|unit| unit.owner != ME)
+        .collect::<Vec<_>>();
+    let mut occupied = all
+        .iter()
+        .map(|unit| {
+            (
+                (unit.position.x, unit.position.y),
+                OccupantInfo {
+                    player_id: unit.owner,
+                    is_transport: false,
+                    unit_type: unit.stats.unit_type,
+                    loadable_types: Vec::new(),
+                    free_slots: 0,
+                },
+            )
+        })
+        .collect::<HashMap<_, _>>();
+    let mut cache = ActionTurnDistanceCache::default();
+    let threats = defense_threats(world, &board, ME, island(world, at), &enemies, &mut cache);
+    let mut result = Allocation {
+        assigned: vec![false; fighters.len()],
+        handled: HashSet::default(),
+        responsibilities: Vec::new(),
+    };
+    result.assign_defenses(
+        &board,
+        &mut occupied,
+        &fighters,
+        &enemies,
+        &threats,
+        &mut cache,
+    );
+    result
+}
