+/// 自軍所有施設を奪おうと迫る敵占領役。
+///
+/// 敵から見た最短の占領先を求め、それが自軍施設である場合だけを脅威とする。
+/// 手近な中立施設を取れる敵や、到達不能な敵は除外する（[`crate::ai::v4::home_defense`] と共通の判定）。
+fn defense_threats(
+    world: &World,
+    board: &Board<'_>,
+    player: PlayerId,
+    island: IslandId,
+    enemies: &[&UnitView<'_>],
+    cache: &mut ActionTurnDistanceCache,
+) -> Vec<Threat> {
+    let empty = HashMap::default();
+    let mut properties = world
+        .iter_entities()
+        .filter_map(|entity| {
+            let position = *entity.get::<GridPosition>()?;
+            let property = *entity.get::<Property>()?;
+            (board
+                .islands
+                .get_island_at(&position)
+                .is_some_and(|found| found.id == island))
+            .then_some((position, property))
+        })
+        .collect::<Vec<_>>();
+    properties.sort_unstable_by_key(|(position, _)| (position.y, position.x));
+
+    let mut threats = Vec::new();
+    for enemy in enemies.iter().filter(|enemy| {
+        enemy.owner != player
+            && enemy.stats.can_capture
+            && board
+                .islands
+                .get_island_at(&enemy.position)
+                .is_some_and(|found| found.id == island)
+    }) {
+        // 一体の占領役を複数拠点へ同時に進ませない。まず敵から見た最早の占領先を選ぶ。
+        // 手近な中立を取れる敵を、遠い自軍拠点への即時脅威として数えない。
+        let target = properties
+            .iter()
+            .filter(|(_, property)| {
+                property.owner_id != Some(enemy.owner) && property.max_capture_points > 0
+            })
+            .filter_map(|(position, property)| {
+                let arrival = turns_to_range(board, &empty, enemy, *position, (0, 0), cache)?
+                    .turns
+                    .max(1);
+                let actions = capture_actions_needed(
+                    property.capture_points,
+                    capture_power_from_hp(enemy.hp),
+                );
+                Some((
+                    arrival.saturating_add(actions),
+                    arrival,
+                    *position,
+                    *property,
+                ))
+            })
+            .min_by_key(|(completion, arrival, position, _)| {
+                (*completion, *arrival, position.y, position.x)
+            });
+        let Some((completion, arrival, _, property)) = target else {
+            continue;
+        };
+        if property.owner_id == Some(player) {
+            // 防衛の最終自軍手番はoffsetで completion-2。
+            // この割当器の移動後初撃は1始まり（現在地からの射撃のみ0）なので、
+            // 今手番に移動して攻撃する候補を落とさないよう同じ時間軸へ換算する。
+            threats.push(Threat {
+                enemy: enemy.entity,
+                eta: arrival,
+                deadline: completion.saturating_sub(1),
+                delay_damage: Some(minimum_capture_delay_damage(
+                    property.capture_points,
+                    enemy.hp,
+                )),
+            });
+        }
+    }
+    threats.sort_unstable_by_key(|threat| (threat.deadline, threat.enemy.to_bits()));
+    threats
+}
