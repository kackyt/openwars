+/// (a-実命令) 防衛責務を受けた戦闘役が、実際に敵歩兵へ向かって移動・攻撃する実命令を出す。
+#[test]
+fn defense_responsibility_issues_actual_movement_command_toward_threat() {
+    let _path = crate::ai::code_path::enter(crate::ai::code_path::CodePath::MainCompatible);
+    let objective = pos(20, 1);
+    let mut world = board(30, 3, objective);
+    let own_city = pos(6, 1);
+    world.spawn((own_city, Property::new(Terrain::City, Some(ME), 200)));
+
+    let tank = unit(&mut world, ME, UnitType::Tank, pos(4, 1), 100);
+    let enemy_infantry_at = pos(10, 1);
+    let enemy = unit(
+        &mut world,
+        ENEMY,
+        UnitType::Infantry,
+        enemy_infantry_at,
+        100,
+    );
+
+    let responsibilities = allocate(&world, &[tank], &[], objective);
+    let for_tank = responsibility_of(&responsibilities, tank);
+    assert_eq!(for_tank.mission_type, MissionType::Attack);
+    assert_eq!(for_tank.target, enemy_infantry_at);
+
+    world.insert_resource(crate::resources::MatchState::default());
+    world.insert_resource(crate::ai::wait_probe::WaitProbe::default());
+    let mut ai = crate::ai::PlayerAiSettings::new();
+    ai.set_version(ME, crate::ai::AiVersion::V4);
+    world.insert_resource(ai);
+    world.insert_resource(crate::ai::squad::SquadManager::default());
+    world.insert_resource(crate::ai::operation_assignment::UnitOperationRegistry::default());
+
+    let mut manager = world
+        .remove_resource::<crate::ai::squad::SquadManager>()
+        .unwrap();
+    let squad_id = {
+        let mut proposals =
+            crate::ai::planning::assignment::OperationLedger::proposals(&mut manager);
+        let mut squad = proposals.create_owned(
+            for_tank.mission_type.clone(),
+            ME,
+            std::collections::BTreeSet::from_iter([tank]),
+            None,
+            Vec::new(),
+        );
+        squad.plan_mut().target = Some(for_tank.target);
+        squad.plan_mut().target_island = Some(island(&world, pos(4, 1)));
+        squad.plan_mut().phase = crate::ai::squad::MissionPhase::MovingToTarget;
+        squad.plan_mut().departure_authorized = true;
+        squad.id
+    };
+    world.insert_resource(manager);
+    let island_id = island(&world, pos(4, 1));
+    world
+        .resource_mut::<crate::ai::operation_assignment::UnitOperationRegistry>()
+        .apply_assign(
+            crate::ai::planning::assignment::LedgerKey::fixture(),
+            tank,
+            crate::ai::operation_assignment::UnitOperationAssignment {
+                owner: crate::ai::operation_assignment::OperationOwner::Campaign {
+                    player_id: ME,
+                    island_id,
+                },
+                squad_id: Some(squad_id),
+                role: crate::ai::operation_assignment::OperationUnitRole::Member,
+                assigned_turn: 1,
+            },
+        );
+
+    let (entity, command) =
+        crate::ai::tactics::v2::decide_action(&mut world, ME, &HashSet::default())
+            .expect("実命令が出る");
+    assert_eq!(entity, tank);
+    match command {
+        crate::ai::command::AiCommand::Wait { target_pos } => {
+            assert!(
+                target_pos.x > 4,
+                "敵歩兵の方向（東）へ前進する位置で待機/射撃構え: {target_pos:?}"
+            );
+        }
+        crate::ai::command::AiCommand::Attack {
+            target_pos,
+            target_entity,
+        } => {
+            assert_eq!(target_entity, enemy);
+            assert!(target_pos.x > 4);
+        }
+        other => panic!("前進または攻撃コマンドを期待したが {other:?}"),
+    }
+}
