+fn threat_approaching_own_property_is_prioritized_for_defense_before_loss() {
+    let objective = pos(20, 1);
+    let mut world = board(30, 3, objective);
+    let own_city = pos(6, 1);
+    world.spawn((own_city, Property::new(Terrain::City, Some(ME), 200)));
+
+    let capturer = unit(&mut world, ME, UnitType::Infantry, pos(19, 1), 100);
+    let tank = unit(&mut world, ME, UnitType::Tank, pos(4, 1), 100);
+    let enemy_infantry_at = pos(10, 1);
+    unit(
+        &mut world,
+        ENEMY,
+        UnitType::Infantry,
+        enemy_infantry_at,
+        100,
+    );
+
+    let responsibilities = allocate(&world, &[tank], &[capturer], objective);
+
+    let for_tank = responsibility_of(&responsibilities, tank);
+    assert_eq!(
+        for_tank.mission_type,
+        MissionType::Attack,
+        "自軍都市を奪いに来る敵歩兵へ攻撃責務を割り当てる"
+    );
+    assert_eq!(
+        for_tank.target, enemy_infantry_at,
+        "標的は自軍都市へ迫る敵歩兵の位置"
+    );
+}
