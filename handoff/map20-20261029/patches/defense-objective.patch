+/// 現在の占領完了手数を1手以上延ばすために必要な最小ダメージ。
+fn minimum_capture_delay_damage(capture_points: u32, hp: u32) -> u32 {
+    let actions = capture_actions_needed(capture_points, capture_power_from_hp(hp));
+    if actions == 0 {
+        // 占領済みの異常な入力では、敵を排除するまで安全と見なさない。
+        return hp;
+    }
+    // 残り占領ポイントが actions 回の占領力より大きければ、必要手数が増える。
+    // 占領力はHPの切り上げ10刻みなので、許容HPも10刻みで切り下げる。
+    let max_power = capture_points.saturating_sub(1) / actions;
+    let max_hp = (max_power / 10).saturating_mul(10);
+    hp.saturating_sub(max_hp)
+}
