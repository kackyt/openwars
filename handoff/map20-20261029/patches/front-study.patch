+    #[test]
+    fn target_selection_prefers_navigable_nearer_property_over_sea_divided_property() {
+        let master_data = MasterDataRegistry::load().expect("master data should load");
+        let mut map = Map::new(4, 3, Terrain::Plains, GridTopology::Square);
+        map.set_terrain(2, 0, Terrain::Sea).unwrap();
+        map.set_terrain(1, 1, Terrain::Sea).unwrap();
+        map.set_terrain(2, 1, Terrain::Sea).unwrap();
+        let island = IslandMap::analyze(&map).islands.remove(0);
+        let player = PlayerId(1);
+        let property = |x, y, owner| PropertySnapshot {
+            position: GridPosition { x, y },
+            property: Property::new(Terrain::City, owner, 200),
+        };
+
+        let properties = vec![
+            property(1, 0, Some(player)),
+            property(0, 2, None),
+            property(3, 0, None),
+        ];
+
+        let target = candidate_target_position(
+            &map,
+            &master_data,
+            &island,
+            &properties,
+            &[],
+            player,
+            IslandCampaignDecision::Expand,
+            None,
+        );
+        assert_eq!(
+            target,
+            Some(GridPosition { x: 0, y: 2 }),
+            "海で隔てられた直線距離2の(3,0)ではなく、実経路3歩の(0,2)が選ばれること"
+        );
+    }
