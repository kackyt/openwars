+/// 前線からの占領優先度計算用のコンテキスト。
+/// 地形および実移動コスト・手番境界（最大移動力）を考慮した実経路距離を事前計算し、
+/// 候補施設ごとの反復呼び出しを O(1) で評価する。
+#[derive(Debug, Clone)]
+pub(in crate::ai::island_campaign_analysis) struct CaptureFrontPriorityContext {
+    friendly_distances: HashMap<GridPosition, (u32, u32)>,
+    enemy_etas: HashMap<GridPosition, u32>,
+    occupation_turns: HashMap<GridPosition, u32>,
+}
+
+impl CaptureFrontPriorityContext {
+    pub(in crate::ai::island_campaign_analysis) fn new(
+        map: &Map,
+        registry: &MasterDataRegistry,
+        island: &Island,
+        properties: &[PropertySnapshot],
+        units: &[UnitSnapshot],
+        player_id: PlayerId,
+        friendly_origins: &[GridPosition],
+    ) -> Self {
+        let (friendly_movement_type, friendly_movement) = [UnitType::Infantry, UnitType::Mech]
+            .into_iter()
+            .filter_map(|unit_type| unit_stats_for_type(registry, unit_type))
+            .min_by_key(|stats| stats.cost)
+            .map_or((MovementType::Infantry, 3), |stats| {
+                (stats.movement_type, stats.max_movement.max(1))
+            });
+
+        let friendly_distances = if !friendly_origins.is_empty() {
+            compute_turn_movement_costs(
+                map,
+                registry,
+                island,
+                friendly_movement_type,
+                friendly_movement,
+                friendly_origins,
+            )
+        } else {
+            HashMap::default()
+        };
+
+        let mut occupation_turns = HashMap::default();
+        for snapshot in properties {
+            if island.tiles.contains(&snapshot.position) {
+                occupation_turns
+                    .insert(snapshot.position, default_capture_turns(&snapshot.property));
+            }
+        }
+
+        let mut enemy_etas: HashMap<GridPosition, u32> = HashMap::default();
+        let enemy_capturers: Vec<_> = units
+            .iter()
+            .filter(|unit| unit.faction != player_id && unit.stats.can_capture)
+            .filter(|unit| unit.transporting.is_none() && island.tiles.contains(&unit.position))
+            .collect();
+
+        // 敵ユニットを (movement_type, max_movement) 別にグループ化し、
+        // 同一特性の敵ユニット群を multi-source で一度に展開する。
+        let mut enemies_by_profile: HashMap<(MovementType, u32), Vec<GridPosition>> =
+            HashMap::default();
+        for enemy in enemy_capturers {
+            let movement = enemy.stats.max_movement.max(1);
+            enemies_by_profile
+                .entry((enemy.stats.movement_type, movement))
+                .or_default()
+                .push(enemy.position);
+        }
+
+        for ((movement_type, max_mp), positions) in enemies_by_profile {
+            let enemy_costs = compute_turn_movement_costs(
+                map,
+                registry,
+                island,
+                movement_type,
+                max_mp,
+                &positions,
+            );
+            for (&target_pos, &(turns, _)) in &enemy_costs {
+                let occ_turns = occupation_turns.get(&target_pos).copied().unwrap_or(1);
+                let eta = turns.saturating_add(occ_turns);
+                enemy_etas
+                    .entry(target_pos)
+                    .and_modify(|min_eta| *min_eta = (*min_eta).min(eta))
+                    .or_insert(eta);
+            }
+        }
+
+        Self {
+            friendly_distances,
+            enemy_etas,
+            occupation_turns,
+        }
+    }
+
+    pub(in crate::ai::island_campaign_analysis) fn priority(
+        &self,
+        target: GridPosition,
+    ) -> (u32, u32, u32, usize, usize) {
+        let occupation_turns = self.occupation_turns.get(&target).copied().unwrap_or(1);
+        let (friendly_turns, front_distance) = self
+            .friendly_distances
+            .get(&target)
+            .copied()
+            .unwrap_or((u32::MAX, u32::MAX));
+        let friendly_eta = if friendly_turns == u32::MAX {
+            u32::MAX
+        } else {
+            friendly_turns.saturating_add(occupation_turns)
+        };
+        let enemy_eta = self.enemy_etas.get(&target).copied().unwrap_or(u32::MAX);
+
+        (friendly_eta, front_distance, enemy_eta, target.y, target.x)
+    }
 }
 
