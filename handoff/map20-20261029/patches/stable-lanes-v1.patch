+    let mut squad_ref = manager.edit_each().find(|s| s.id == squad_id).unwrap();
+    squad_ref.plan_mut().target = Some(front_south);
+    world.insert_resource(manager);
+
+    let mut manager = world
+        .remove_resource::<crate::ai::squad::SquadManager>()
+        .unwrap();
+    crate::ai::v4::capital_route::commitment::refresh_capital_route_path_commitments(
+        &mut world,
+        player,
+        &mut manager,
+    );
+    world.insert_resource(manager);
+
+    // 明示的な転換によって、旧 route 0 ではなく新しい route 1 へ正常に切り替わること
+    let path_registry = world.resource::<CapitalRoutePathRegistry>();
+    let comm = path_registry
+        .commitments
+        .get(&squad_id)
+        .expect("commitment for switched squad");
+    assert_eq!(
+        comm.route,
+        CapitalRouteId(1),
+        "明示的な戦略転換により新しい枝route 1へ切り替わること"
+    );
+}
