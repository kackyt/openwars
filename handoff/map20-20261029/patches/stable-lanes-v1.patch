+/// ユニットが所属していた既存Squadの首都ルート継続契約を返す。
+///
+/// 目標拠点を自軍が確保した場合や、被撃破・回復中・他プレイヤーのユニットの場合は契約解除（None）とする。
+pub(crate) fn active_route_commitment_for_entity(
+    world: &World,
+    entity: Entity,
+    player_id: PlayerId,
+    island_id: crate::ai::islands::IslandId,
+) -> Option<CapitalRouteCommitment> {
+    let faction = world.get::<Faction>(entity)?;
+    if faction.0 != player_id {
+        return None;
+    }
+    let hp = world.get::<Health>(entity)?.current;
+    if hp == 0 {
+        return None;
+    }
+    if crate::ai::v4::capital_route::tactical::capital_route_is_recovering(world, player_id, entity)
+    {
+        return None;
+    }
+    let op_registry =
+        world.get_resource::<crate::ai::operation_assignment::UnitOperationRegistry>()?;
+    let squad_id = op_registry
+        .assignment(entity)
+        .and_then(|a| a.squad_id)
+        .or_else(|| op_registry.previous_squad(entity))?;
+
+    let path_registry = world.get_resource::<CapitalRoutePathRegistry>()?;
+    let commitment = path_registry.commitments.get(&squad_id)?.clone();
+
+    if commitment.player_id != player_id || commitment.island_id != island_id {
+        return None;
+    }
+
+    // 目標確保時の解除: commitment.target が既に自軍拠点なら解除
+    let target_secured = world.iter_entities().any(|e| {
+        e.get::<GridPosition>() == Some(&commitment.target)
+            && e.get::<Property>()
+                .is_some_and(|p| p.owner_id == Some(player_id))
+    });
+    if target_secured {
+        return None;
+    }
+
+    Some(commitment)
+}
