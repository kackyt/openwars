+fn campaign_reorganization_preserves_route_commitments_without_cross_assignment() {
+    let _code_path = crate::ai::code_path::enter(crate::ai::code_path::CodePath::MainCompatible);
+    let player = PlayerId(2);
+    let (mut world, island) = map6_route_world(player);
+    let mut settings = crate::ai::ai_version::PlayerAiSettings::new();
+    settings.set_version(player, crate::ai::ai_version::AiVersion::V4);
+    world.insert_resource(settings);
+    world.insert_resource(
+        crate::ai::strategy_profile::V4StrategyProfileRegistry::with_profile(
+            player,
+            crate::ai::strategy_profile::V4StrategyProfile::Standard,
+        ),
+    );
+
+    let topology = capital_route_topology_for(&world, player, island)
+        .unwrap()
+        .clone();
+    assert_eq!(topology.routes.len(), 2, "map_6 has 2 routes");
+
+    let front_north = topology.routes[0].front;
+    let front_south = topology.routes[1].front;
+
+    let unit_north = world
+        .spawn((
+            Faction(player),
+            front_north,
+            Health {
+                current: 100,
+                max: 100,
+            },
+            stats(UnitType::Tank, 7000),
+        ))
+        .id();
+
+    let unit_south = world
+        .spawn((
+            Faction(player),
+            front_south,
+            Health {
+                current: 100,
+                max: 100,
+            },
+            stats(UnitType::Tank, 7000),
+        ))
+        .id();
+
+    let mut manager = crate::ai::squad::SquadManager::default();
+    let mut squad_n = manager.create_owned_squad(MissionType::Attack, player);
+    squad_n.members.insert(unit_north);
+    squad_n.plan_mut().target = Some(front_north);
+    squad_n.plan_mut().target_island = Some(island);
+    let squad_n_id = squad_n.id;
+
+    let mut squad_s = manager.create_owned_squad(MissionType::Attack, player);
+    squad_s.members.insert(unit_south);
+    squad_s.plan_mut().target = Some(front_south);
+    squad_s.plan_mut().target_island = Some(island);
+    let squad_s_id = squad_s.id;
+
+    let mut op_registry = crate::ai::operation_assignment::UnitOperationRegistry::default();
+    op_registry.assign(
+        unit_north,
+        crate::ai::operation_assignment::UnitOperationAssignment {
+            owner: crate::ai::operation_assignment::OperationOwner::TacticalSquad {
+                player_id: player,
+                squad_id: squad_n_id,
+            },
+            squad_id: Some(squad_n_id),
+            role: crate::ai::operation_assignment::OperationUnitRole::Member,
+            assigned_turn: 5,
+        },
+    );
+    op_registry.assign(
+        unit_south,
+        crate::ai::operation_assignment::UnitOperationAssignment {
+            owner: crate::ai::operation_assignment::OperationOwner::TacticalSquad {
+                player_id: player,
+                squad_id: squad_s_id,
+            },
+            squad_id: Some(squad_s_id),
+            role: crate::ai::operation_assignment::OperationUnitRole::Member,
+            assigned_turn: 5,
