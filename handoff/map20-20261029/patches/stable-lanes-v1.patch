+    // 局面: T8で目の前の敵ユニットはいなくなった（戦闘標的の消滅）
+    // しかし南施設 front_south は敵所有のまま（DAG地域の所有変化なし）
+    let requirement = crate::ai::island_campaign::IslandCampaignRequirement {
+        preferred_transport: None,
+        transport_slots: 0,
+        capture_units: 0,
+        ground_combat_units: 1,
+        combat_units: 1,
+        total_budget: 7_000,
+    };
+    let assignment = crate::ai::island_campaign::IslandCampaignAssignment {
+        island_id: island,
+        decision: crate::ai::island_campaign::IslandCampaignDecision::Assault,
+        target_position: topology.nodes[topology.goal_node.0].anchor,
+        capture_target_positions: vec![front_north, front_south],
+        priority_enemy_types: Vec::new(),
+        requirement: requirement.clone(),
