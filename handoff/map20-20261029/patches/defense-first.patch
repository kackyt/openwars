+                    Faction(owner),
+                    Health {
+                        current: 100,
+                        max: 100,
+                    },
+                    Fuel {
+                        current: stats.max_fuel,
+                        max: stats.max_fuel,
+                    },
+                    Ammo {
+                        ammo1: stats.max_ammo1,
+                        max_ammo1: stats.max_ammo1,
+                        ammo2: stats.max_ammo2,
+                        max_ammo2: stats.max_ammo2,
+                    },
+                    HasMoved(false),
+                    ActionCompleted(false),
+                    stats,
+                ))
+                .id()
+        };
+        let defender = spawn(
