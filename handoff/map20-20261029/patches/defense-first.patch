+            player,
+            UnitType::Tank,
+            GridPosition { x: 1, y: 1 },
+        );
+        let capturer = spawn(
+            &mut world,
+            player,
+            UnitType::Infantry,
+            GridPosition { x: 0, y: 0 },
+        );
+        let enemy = spawn(
+            &mut world,
+            opponent,
+            UnitType::Infantry,
+            GridPosition { x: 2, y: 2 },
+        );
+        let mut manager = SquadManager::default();
+        let squad = {
+            let mut squad = manager.create_owned_squad(MissionType::Capture, player);
+            squad.members.insert(capturer);
+            squad.plan.target = Some(GridPosition { x: 0, y: 0 });
+            squad.plan.target_island = Some(island);
+            squad.plan.departure_authorized = true;
+            squad.id
+        };
+        let defense_squad = {
+            let mut squad = manager.create_owned_squad(MissionType::Attack, player);
+            squad.members.insert(defender);
+            squad.plan.target = Some(GridPosition { x: 8, y: 2 });
+            squad.plan.target_island = Some(island);
+            squad.plan.departure_authorized = true;
+            squad.id
+        };
+        world.insert_resource(manager);
+        let mut registry = UnitOperationRegistry::default();
+        for (entity, squad_id) in [(capturer, squad), (defender, defense_squad)] {
+            registry.apply_assign(
+                LedgerKey::fixture(),
+                entity,
+                UnitOperationAssignment {
+                    owner: OperationOwner::Campaign {
+                        player_id: player,
+                        island_id: island,
+                    },
+                    squad_id: Some(squad_id),
+                    role: OperationUnitRole::Member,
+                    assigned_turn: 1,
+                },
+            );
+        }
+        world.insert_resource(registry);
+        world.insert_resource(
+            crate::ai::strategy_profile::V4StrategyProfileRegistry::with_profile(
+                player,
+                crate::ai::strategy_profile::V4StrategyProfile::Standard,
+            ),
+        );
+        let mut progress = AiTurnProgress::default();
+        progress.mark_squads_planned(player);
+        world.insert_resource(progress);
+        let mut attacks = world
+            .resource::<Events<crate::events::AttackUnitCommand>>()
+            .get_cursor();
+        let command = execute_turn_step(&mut world, player).expect("防衛命令を発行する");
+        let issued = attacks
+            .read(world.resource::<Events<crate::events::AttackUnitCommand>>())
+            .collect::<Vec<_>>();
+        assert!(
+            issued
+                .iter()
+                .any(|event| event.attacker_entity == defender && event.defender_entity == enemy),
+            "最後の占領手番を止められる守備役を先に発行する: {command}"
+        );
+        assert!(world.resource::<AiActionCooldown>().0.contains(&defender));
+        let registry = world.resource::<UnitOperationRegistry>();
+        assert_eq!(registry.assignment(capturer).unwrap().squad_id, Some(squad));
+        assert_eq!(
+            registry.assignment(defender).unwrap().squad_id,
+            Some(defense_squad)
+        );
+        let manager = world.resource::<SquadManager>();
+        let defender_plan = &manager
+            .squads
+            .iter()
+            .find(|entry| entry.id == defense_squad)
+            .unwrap()
+            .plan;
+        assert_eq!(defender_plan.target, Some(GridPosition { x: 8, y: 2 }));
+    }
+
+    #[test]
+    fn defense_entry_is_limited_to_v4_without_changing_small_map_selection() {
+        let player = PlayerId(1);
+        let mut world = World::new();
+        let mut settings = PlayerAiSettings::new();
+        settings.set_version(player, AiVersion::V3);
+        world.insert_resource(settings);
+        let v3 = TurnStep::begin(&world, player, CodePath::MainCompatible);
+        assert_eq!(v3.tactics, TurnTactics::Standard);
+        assert!(!v3.early_relief_includes_active_missions());
+
+        world
+            .resource_mut::<PlayerAiSettings>()
+            .set_version(player, AiVersion::V4);
+        let standard = TurnStep::begin(&world, player, CodePath::MainCompatible);
+        assert_eq!(standard.tactics, TurnTactics::Standard);
+        assert!(standard.early_relief_includes_active_missions());
+        let small = TurnStep::begin(&world, player, CodePath::Extended);
+        assert_eq!(small.tactics, TurnTactics::SmallMapSquads);
+        assert!(!small.early_relief_includes_active_missions());
+    }
+}
