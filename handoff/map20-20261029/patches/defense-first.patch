+            map.set_terrain(pos.x, pos.y, terrain).unwrap();
+            let mut property = Property::new(terrain, owner, 200);
+            property.capture_points = capture_points;
+            world.spawn((pos, property));
+        }
+        let island = IslandMap::analyze(&map)
