+/// 最後の行動で占領される拠点について、予測被害が実際に占領を遅らせるか。
+fn delays_last_capture(world: &World, threat: Threat, enemy_hp: u32, damage: u32) -> bool {
+    let Some(property) = world.iter_entities().find_map(|entity| {
+        (entity.get::<GridPosition>() == Some(&threat.property))
+            .then(|| entity.get::<Property>().copied())
+            .flatten()
+    }) else {
+        return false;
+    };
+    if damage >= enemy_hp {
+        return true;
+    }
+    let actions = |hp| {
+        super::property_control::capture_actions_needed(
+            property.capture_points,
+            super::property_control::capture_power_from_hp(hp),
+        )
+    };
+    actions(enemy_hp.saturating_sub(damage)) > actions(enemy_hp)
+}
