+    #[test]
+    fn early_relief_does_not_preempt_normal_advance_when_forward_path_will_clear() {
+        use crate::ai::AiVersion;
+        use crate::ai::runtime::turn::execute_turn_step;
+        use crate::ai::strategy_profile::{V4StrategyProfile, V4StrategyProfileRegistry};
+
+        let player = PlayerId(1);
+        let enemy = PlayerId(2);
+        let mut world = setup_v3_test_world(6, AiVersion::V4);
+        world.insert_resource(V4StrategyProfileRegistry::with_profile(
+            player,
+            V4StrategyProfile::Standard,
+        ));
+
+        // 6x2マップ:
+        // (0,0): Capital, (1,0): Factory, (2,0): Forest, (3,0): Forest, (4,0): Plains, (5,0): City(Enemy)
+        // (0,1): Plains,  (1,1): Sea,     (2,1): Sea,    (3,1): Sea,    (4,1): Plains, (5,1): Plains
+        let map = Map {
+            width: 6,
+            height: 2,
+            tiles: vec![
+                Terrain::Capital,
+                Terrain::Factory,
+                Terrain::Forest,
+                Terrain::Forest,
+                Terrain::Plains,
+                Terrain::City,
+                Terrain::Plains,
+                Terrain::Sea,
+                Terrain::Sea,
+                Terrain::Sea,
+                Terrain::Plains,
+                Terrain::Plains,
+            ],
+            topology: crate::resources::GridTopology::Square,
+        };
+        world.insert_resource(map.clone());
+        world.insert_resource(crate::ai::islands::IslandMap::analyze(&map));
+        world.insert_resource(DamageChart::new());
+
+        world.spawn((
+            GridPosition { x: 0, y: 0 },
+            Property::new(Terrain::Capital, Some(player), 100),
+        ));
+        world.spawn((
+            GridPosition { x: 1, y: 0 },
+            Property::new(Terrain::Factory, Some(player), 100),
+        ));
+        world.spawn((
+            GridPosition { x: 5, y: 0 },
+            Property::new(Terrain::City, Some(enemy), 100),
+        ));
+
+        let stats = world
+            .resource::<MasterDataRegistry>()
+            .create_unit_stats(&crate::resources::master_data::UnitName(
+                UnitType::Infantry.as_str().to_owned(),
+            ))
+            .unwrap();
+
+        // 工場(1,0)上の歩兵A
+        let unit_a = world
+            .spawn((
+                player,
+                Faction(player),
+                HasMoved(false),
+                ActionCompleted(false),
+                GridPosition { x: 1, y: 0 },
+                stats.clone(),
+                Health {
+                    current: 100,
+                    max: 100,
+                },
+                crate::components::Fuel {
+                    current: stats.max_fuel,
+                    max: stats.max_fuel,
+                },
+            ))
+            .id();
+
+        // 前方(2,0)の森にいる歩兵B（未行動）
+        let unit_b = world
+            .spawn((
+                player,
+                Faction(player),
+                HasMoved(false),
+                ActionCompleted(false),
+                GridPosition { x: 2, y: 0 },
+                stats.clone(),
+                Health {
+                    current: 100,
+                    max: 100,
+                },
+                crate::components::Fuel {
+                    current: stats.max_fuel,
+                    max: stats.max_fuel,
+                },
+            ))
+            .id();
+
+        let mut progress = AiTurnProgress::default();
+        progress.mark_squads_planned(player);
+        world.insert_resource(progress);
+
+        let mut manager = crate::ai::squad::SquadManager::new();
+        let mut squad = manager.create_owned_squad(crate::ai::squad::MissionType::Attack, player);
+        squad.members.insert(unit_a);
+        squad.members.insert(unit_b);
+        squad.plan.target = Some(GridPosition { x: 5, y: 0 });
+        squad.plan.phase = crate::ai::squad::MissionPhase::MovingToTarget;
+        world.insert_resource(manager);
+
+        world.init_resource::<Events<crate::events::ProduceUnitCommand>>();
+        world.init_resource::<Events<crate::events::NextPhaseCommand>>();
+
+        // 1手目の実行
+        let cmd = execute_turn_step(&mut world, player).expect("命令が発行されること");
+        let acted = world
+            .get_resource::<AiActionCooldown>()
+            .map(|c| c.0.clone())
+            .unwrap_or_default();
+
+        assert!(
+            !acted.contains(&unit_a),
+            "工場上のunit_aは前方のunit_bが動く前に目標と逆方向(0,1)へ早期退避してはならない (cmd: {cmd})"
+        );
+        assert!(
+            acted.contains(&unit_b),
+            "前方のunit_bが先に前進するべきである (cmd: {cmd})"
+        );
+    }
+
+    #[test]
+    fn late_relief_vacates_factory_when_unit_cannot_advance() {
+        use crate::ai::AiVersion;
+        use crate::ai::runtime::turn::execute_turn_step;
+        use crate::ai::strategy_profile::{V4StrategyProfile, V4StrategyProfileRegistry};
+
+        let player = PlayerId(1);
+        let enemy = PlayerId(2);
+        let mut world = setup_v3_test_world(6, AiVersion::V4);
+        world.insert_resource(V4StrategyProfileRegistry::with_profile(
+            player,
+            V4StrategyProfile::Standard,
+        ));
+
+        // 6x2マップ: (2,0)がSeaで東へは物理的に進めない盤面
+        let map = Map {
+            width: 6,
+            height: 2,
+            tiles: vec![
+                Terrain::Capital,
+                Terrain::Factory,
+                Terrain::Sea,
+                Terrain::Forest,
+                Terrain::Plains,
+                Terrain::City,
+                Terrain::Plains,
+                Terrain::Sea,
+                Terrain::Sea,
+                Terrain::Sea,
+                Terrain::Plains,
+                Terrain::Plains,
+            ],
+            topology: crate::resources::GridTopology::Square,
+        };
+        world.insert_resource(map.clone());
+        world.insert_resource(crate::ai::islands::IslandMap::analyze(&map));
+        world.insert_resource(DamageChart::new());
+
+        world.spawn((
+            GridPosition { x: 0, y: 0 },
+            Property::new(Terrain::Capital, Some(player), 100),
+        ));
+        world.spawn((
+            GridPosition { x: 1, y: 0 },
+            Property::new(Terrain::Factory, Some(player), 100),
+        ));
+        world.spawn((
+            GridPosition { x: 5, y: 0 },
+            Property::new(Terrain::City, Some(enemy), 100),
+        ));
+
+        let stats = world
+            .resource::<MasterDataRegistry>()
+            .create_unit_stats(&crate::resources::master_data::UnitName(
+                UnitType::Infantry.as_str().to_owned(),
+            ))
+            .unwrap();
+
+        // 工場(1,0)上の歩兵A（東へは進めず、通常行動では候補なし）
+        let unit_a = world
+            .spawn((
+                player,
+                Faction(player),
+                HasMoved(false),
+                ActionCompleted(false),
+                GridPosition { x: 1, y: 0 },
+                stats.clone(),
+                Health {
+                    current: 100,
+                    max: 100,
+                },
+                crate::components::Fuel {
+                    current: stats.max_fuel,
+                    max: stats.max_fuel,
+                },
+            ))
+            .id();
+
+        let mut progress = AiTurnProgress::default();
+        progress.mark_squads_planned(player);
+        world.insert_resource(progress);
+
+        let mut manager = crate::ai::squad::SquadManager::new();
+        let mut squad = manager.create_owned_squad(crate::ai::squad::MissionType::Attack, player);
+        squad.members.insert(unit_a);
+        squad.plan.target = Some(GridPosition { x: 5, y: 0 });
+        squad.plan.phase = crate::ai::squad::MissionPhase::MovingToTarget;
+        world.insert_resource(manager);
+
+        world.init_resource::<Events<crate::events::ProduceUnitCommand>>();
+        world.init_resource::<Events<crate::events::NextPhaseCommand>>();
+
+        // 通常行動で動けなくても、遅い退避によって工場を空ける退避命令が出る
+        let cmd = execute_turn_step(&mut world, player).expect("退避命令が発行されること");
+        let acted = world
+            .get_resource::<AiActionCooldown>()
+            .map(|c| c.0.clone())
+            .unwrap_or_default();
+
+        assert!(
+            acted.contains(&unit_a),
+            "前進不能なunit_aは遅い退避で工場を空けること (cmd: {cmd})"
+        );
+        assert!(
+            cmd.contains("GridPosition { x: 0, y: 1 }"),
+            "退避先は唯一空いている(0,1)であること (cmd: {cmd})"
+        );
+    }
